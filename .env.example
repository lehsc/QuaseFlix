# Copy this file to .env and replace the placeholders. Never commit .env.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/quaseflix

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
QUASEFLIX_SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_VALUE

# Registration and billing messages are written here during local development.
QUASEFLIX_OUTBOX=./tmp/quaseflix-outbox

# Optional. Leave empty when Google Sign-In is not being tested.
GOOGLE_CLIENT_ID=
